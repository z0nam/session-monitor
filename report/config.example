# smon-report 개인 설정 — 이 파일을 ~/.config/smon-report/config 로 복사해 채운다.
#   cp report/config.example ~/.config/smon-report/config
# run-report.sh 가 실행 시 source 한다. (SMON_REPORT_CONFIG 로 경로 override 가능)

# 리포트를 받을 본인 Slack member ID (U로 시작). Slack 프로필 → "멤버 ID 복사".
SLACK_SELF="U0XXXXXXXXX"

# (선택) 헤드리스 실행용 Claude 전용 장기 토큰 파일 경로.
#   `claude setup-token` 으로 발급한 토큰을 저장(chmod 600)하면, 대화형 로그인이
#   풀려도 리포트는 독립적으로 돈다. 없으면 기존 OAuth 세션으로 폴백.
# CLAUDE_TOKEN_FILE="$HOME/.config/smon-report/claude-token"

# (선택) 발신 경로. auto(기본) = 봇 토큰이 있으면 봇, 없으면 사용자 토큰.
#   bot  — 봇 이름으로 도착. 원내 배포 기본값(각자 Slack 앱을 만들 필요가 없다).
#          토큰: $SLACK_BOT_TOKEN / $SLACK_BOT_TOKEN_FILE /
#                ~/.config/smon-report/slack-bot-token / ~/.config/calendar-worklog/slack-bot-token
#   user — 본인 이름으로 도착. 봇 계정이 없는 환경의 대비책이자 본인 이름을 원할 때.
# REPORT_SENDER="auto"

# (선택) 사용자 토큰(xoxp) 경로 — REPORT_SENDER=user 일 때. 기본값은 아래와 같다.
#   발신자가 토큰 주인으로 고정되므로, 본인 계정 토큰이어야 본인 DM 에 본인 이름으로 들어간다.
#   필요 scope: chat:write, canvases:write (+ im:write, canvases:read 권장)
# SLACK_TOKEN_ENV_FILE="$HOME/dev/ji-slack-admin/slack-directory/.env"
# SLACK_TOKEN_VAR="SLACK_USER_TOKEN"

# (선택) 리포트를 보낼 담당 머신의 hostname -s. 여러 머신에 잡을 켰을 때 중복 DM 방지.
#   지정하면 그 머신에서만 돌고, 나머지는 "담당 아님"으로 조용히 빠진다.
# REPORT_HOST="studio"

# (선택) 오늘 것이 이미 갔는지 Slack 검색으로 확인(기본 1). 사용자 토큰(search:read)일 때만 동작.
# REPORT_DEDUP=1
