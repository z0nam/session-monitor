<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.namun.smon-report</string>

  <key>ProgramArguments</key>
  <array>
    <string>__REPO__/report/run-report.sh</string>
  </array>

  <!-- 매일 07:50. 아침 브리핑(08:00) 직전에 프로젝트 상태부터. 트라이얼 후 브리핑과 병합 고려. -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>7</integer>
    <key>Minute</key><integer>50</integer>
  </dict>

  <!-- 러너가 자체 로그(report/logs/)를 쓰므로 여기선 부팅 실패만 잡는다. -->
  <key>StandardErrorPath</key>
  <string>__REPO__/report/logs/launchd.err</string>

  <key>RunAtLoad</key>
  <false/>

  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
